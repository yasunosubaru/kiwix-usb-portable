# 统一以 LF 存入仓库，避免跨平台换行问题
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则 cmd.exe 可能解析异常
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本与 Python 必须是 LF，否则在 Linux/NAS 上无法执行
*.sh text eol=lf
*.py text eol=lf

# 二进制
*.exe binary
*.zim binary
*.tar binary
*.zip binary
*.ico binary
*.png binary

# 许可证与文档按原样
LICENSE text eol=lf
*.md text eol=lf
