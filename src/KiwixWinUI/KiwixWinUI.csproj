<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 is the minimum Windows 10 build the Windows App SDK supports. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KiwixWinUI</RootNamespace>
    <AssemblyName>KiwixWinUI</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: no MSIX, no install, the output folder is the app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Ship the Windows App Runtime with the app so a plain USB stick works. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!--
      Without this the exe carries no RT_GROUP_ICON and Windows shows the
      generic blank-page icon in Explorer and on the taskbar. MSBuild emits the
      Win32 resources itself, so unlike the native launcher this needs no
      resource compiler. Ten resolutions, 32-bit alpha; see src\branding.
    -->
    <ApplicationIcon>..\branding\kiwix.ico</ApplicationIcon>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishSingleFile>false</PublishSingleFile>
    <IsPackable>false</IsPackable>

    <!--
      Single source of truth for the launcher version. It used to be a const in
      MainWindow.xaml.cs plus a separate string in KiwixUSB.py, and the two
      drifted apart across releases: the window claimed v1.1.2 inside a v1.2.0
      bundle. The header now reads this at runtime, and test-gui-start.ps1
      compares what is displayed against this value, so bumping the version here
      and forgetting the rest fails the build instead of shipping a lie.

       The number itself now lives one level up, in src/Directory.Build.props,
       because there are three executables in a bundle and each declaring
       its own copy is how they drift apart. The native launcher stub has no
       project file and parses that same props file.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!--
    XAML files are picked up by the SDK's default Page/ApplicationDefinition
    globs. Do NOT declare them explicitly (duplicate item error) and do NOT
    set EnableDefaultPageItems=false (that silently skips the XAML compiler,
    leaving InitializeComponent() undefined in the code-behind).
  -->

</Project>
