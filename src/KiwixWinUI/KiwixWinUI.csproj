<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 is the minimum Windows 10 build the Windows App SDK supports. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KiwixWinUI</RootNamespace>
    <AssemblyName>KiwixWinUI</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: no MSIX, no install, the output folder is the app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Ship the Windows App Runtime with the app so a plain USB stick works. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishSingleFile>false</PublishSingleFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!--
    XAML files are picked up by the SDK's default Page/ApplicationDefinition
    globs. Do NOT declare them explicitly (duplicate item error) and do NOT
    set EnableDefaultPageItems=false (that silently skips the XAML compiler,
    leaving InitializeComponent() undefined in the code-behind).
  -->

</Project>
