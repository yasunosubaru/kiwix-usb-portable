<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The Apple metrics, as resources rather than magic numbers sprinkled through
    the window. Everything here is either a HIG constant or an SF type-ramp
    step, so the whole design language can be checked against the guidelines in
    one file.

    Font: Segoe UI is the Windows system UI face and the closest thing to SF Pro
    that exists on every machine this can run on; Avalonia falls back per glyph,
    so the Chinese strings render in Microsoft YaHei UI. Naming Inter here
    instead would make the text depend on an embedded font and inherit its
    missing CJK coverage.
  -->
  <FontFamily x:Key="AppleFont">Segoe UI</FontFamily>
  <FontFamily x:Key="AppleMonoFont">Consolas</FontFamily>

  <!-- Corner radii: 8 / 10 / 12, plus 14 for the alert sheet. -->
  <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="RadiusAlert">14</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Margins: the 16pt screen gutter, the 12pt inner inset, the 8pt grid. -->
  <Thickness x:Key="Gutter">16</Thickness>
  <Thickness x:Key="Grid8">0,0,0,8</Thickness>
  <Thickness x:Key="Grid16">0,0,0,16</Thickness>
  <Thickness x:Key="Grid24">0,0,0,24</Thickness>
  <Thickness x:Key="InsetLeft">16,0,0,0</Thickness>

  <!-- 44pt: the HIG minimum touch target, used for every interactive row. -->
  <x:Double x:Key="TouchTarget">44</x:Double>
  <x:Double x:Key="RowHeight">44</x:Double>

  <!-- SF type ramp (points), relative sizes exactly as the guidelines list them. -->
  <x:Double x:Key="SizeLargeTitle">34</x:Double>
  <x:Double x:Key="SizeTitle1">28</x:Double>
  <x:Double x:Key="SizeTitle2">22</x:Double>
  <x:Double x:Key="SizeTitle3">20</x:Double>
  <x:Double x:Key="SizeHeadline">17</x:Double>
  <x:Double x:Key="SizeBody">17</x:Double>
  <x:Double x:Key="SizeCallout">16</x:Double>
  <x:Double x:Key="SizeSubhead">15</x:Double>
  <x:Double x:Key="SizeFootnote">13</x:Double>
  <x:Double x:Key="SizeCaption1">12</x:Double>
  <x:Double x:Key="SizeCaption2">11</x:Double>

</ResourceDictionary>
